# Chaîne de connexion MongoDB (Atlas ou locale)
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/port-russell
# Base dédiée aux tests (facultatif : sinon base MongoDB en mémoire)
MONGODB_URI_TEST=mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/port-russell-test
# Port d'écoute du serveur
PORT=3000
# Secret de signature des jetons JWT (longue chaîne aléatoire)
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire
# Durée de validité du jeton
JWT_EXPIRES_IN=24h
# Compte créé par le script d'import (npm run seed)
ADMIN_NAME=Capitainerie
ADMIN_EMAIL=capitainerie@port-russell.fr
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe
# Mettre à false pour ne pas lancer les tests au démarrage
RUN_TESTS_ON_START=true
