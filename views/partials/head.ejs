<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Application de gestion des catways et des réservations du port de plaisance Russell.">
  <title><%= title %> · Port de plaisance Russell</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a class="skip-link" href="#contenu">Aller au contenu</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/">
        <img src="/favicon.svg" alt="" width="32" height="32">
        <span>Port de plaisance <strong>Russell</strong></span>
      </a>
      <nav aria-label="Navigation principale">
        <ul class="nav">
          <% if (currentUser) { %>
            <li><a href="/tableau-de-bord"<%- currentPath === '/tableau-de-bord' ? ' aria-current="page"' : '' %>>Tableau de bord</a></li>
            <li><a href="/catways"<%- currentPath.startsWith('/catways') ? ' aria-current="page"' : '' %>>Catways</a></li>
            <li><a href="/reservations"<%- currentPath === '/reservations' ? ' aria-current="page"' : '' %>>Réservations</a></li>
          <% } %>
          <li><a href="/documentation"<%- currentPath === '/documentation' ? ' aria-current="page"' : '' %>>Documentation</a></li>
          <% if (currentUser) { %>
            <li><a class="btn btn-small btn-outline" href="/logout">Déconnexion</a></li>
          <% } %>
        </ul>
      </nav>
    </div>
  </header>
  <main id="contenu" class="container">
